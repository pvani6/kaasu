# Copy this file to ".env" and fill in your own values.
# NEVER upload .env to GitHub (it is already listed in .gitignore).

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Leave as-is for sandbox:
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Optional: your name/business as shown on invoices
INVOICER_NAME=
# Optional: webhook id (only if you create a sandbox webhook pointing to /api/webhooks/paypal)
PAYPAL_WEBHOOK_ID=

# --- Google Gemini (free key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# If you get a "model not found" error, change this to a model listed in Google AI Studio
GEMINI_MODEL=gemini-2.5-flash

# --- App ---
PORT=3000
# How often (minutes) the agent scans for invoices to chase. 0 = only when you click the button.
AGENT_SCAN_MINUTES=30
